# Development mode - set to 'true' to skip API calls and return mock responses
DEV_MODE=true

# AI Pipeline Keys (not needed when DEV_MODE=true)
GEMINI_API_KEY=
STABILITY_API_KEY=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Supabase (not needed when DEV_MODE=true)
# Get these from: Supabase Dashboard > Settings > API
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Upstash Redis (for caching research + wizard sessions)
# Get these from: https://console.upstash.com > Create Database > REST API
# Not required when DEV_MODE=true (uses in-memory cache)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
